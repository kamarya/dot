  "tokenColors": [
    {
      "settings": {
        "foreground": "#ffffff",
        "background": "#090c12"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#888888",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#ff82ab"
      }
    },
    {
      "name": "String delimiter / punctuation",
      "scope": [
        "punctuation.definition.string",
        "string.quoted.single.js punctuation",
        "punctuation.separator.delimiter"
      ],
      "settings": {
        "foreground": "#668799"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#ffa0a0"
      }
    },
    {
      "name": "Constant / language constant",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffa0a0"
      }
    },
    {
      "name": "Variable / identifier",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#b9d3ee"
      }
    },
    {
      "name": "Instance / member variable",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#c6b6fe"
      }
    },
    {
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#c6e2ff"
      }
    },
    {
      "name": "Keyword / statement",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type.function"
      ],
      "settings": {
        "foreground": "#6495ed",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#6495ed"
      }
    },
    {
      "name": "Storage / storage class",
      "scope": ["storage", "storage.modifier"],
      "settings": {
        "foreground": "#6ca6cd"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7ec0ee"
      }
    },
    {
      "name": "Preprocessor / import / include",
      "scope": [
        "keyword.control.import",
        "keyword.control.directive",
        "entity.name.tag.preprocessor",
        "meta.preprocessor",
        "punctuation.definition.preprocessor"
      ],
      "settings": {
        "foreground": "#ee3a8c"
      }
    },
    {
      "name": "Special / escape sequence",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ffc0cb"
      }
    },
    {
      "name": "Tag (HTML/XML)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#6495ed"
      }
    },
    {
      "name": "Attribute name",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#ee3a8c"
      }
    },
    {
      "name": "Symbol / atom (Ruby, Elixir, Erlang)",
      "scope": ["constant.other.symbol"],
      "settings": {
        "foreground": "#7697d6"
      }
    },
    {
      "name": "Regexp",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#dd0093"
      }
    },
    {
      "name": "Markup heading / title",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#70b950",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup inserted / deleted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#32cd32"
      }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#ff0000"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ffffff",
        "background": "#902020"
      }
    }
  ]
}
